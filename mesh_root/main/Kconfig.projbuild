menu "Example Configuration"

    config MESH_ROOT
        select JOIN_MESH_IGNORE_ROUTER_STATUS
        bool "Root device"
        default n
        help
            Configure the root device type.

    config MESH_CHANNEL
        int "Mesh network channel"
        range 1 14
        default 11
        help
            Mesh network channel.

menu "UART Bridge"
config UART_BRIDGE_PORT
    int "UART port number"
    range 0 2
    default 1
config UART_BRIDGE_BAUD
    int "Baud rate"
    default 115200
config UART_BRIDGE_TX_PIN
    int "TX GPIO"
    default 43
config UART_BRIDGE_RX_PIN
    int "RX GPIO"
    default 44
endmenu
