# Override some defaults in mesh application project.

#
# FreeRTOS
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

#
# ESP32-specific
#
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# LWIP
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

CONFIG_MESH_LITE_ENABLE=y
CONFIG_MESH_LITE_NODE_INFO_REPORT=y

# --- Mesh-Lite backhaul + user AP ---
CONFIG_MESH_CHANNEL=6
CONFIG_BRIDGE_SOFTAP_SSID="meshmesh"
CONFIG_BRIDGE_SOFTAP_PASSWORD="12345678"
CONFIG_BRIDGE_SOFTAP_SSID_END_WITH_THE_MAC=n

# --- PSRAM / Memory helpful for LVGL ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_ESP_TASK_WDT_EN=y

# --- LVGL port defaults (safe, small) ---
CONFIG_LVGL_PORT=y
CONFIG_LVGL_USE_DEMOS=n
CONFIG_LVGL_TICK_CUSTOM=y
CONFIG_LVGL_TICK_CUSTOM_PERIOD_US=5000
CONFIG_LVGL_MEM_CUSTOM=y

# --- LCD RGB support in IDF ---
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
